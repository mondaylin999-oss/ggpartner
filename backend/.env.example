# Native development. Never put the service-account JSON under frontend/.
DATABASE_URL=postgresql://ggpartner:change-this-local-password@localhost:5432/ggpartner
PORT=3000
APP_ORIGIN=http://localhost:3000
# Leave blank to start in unconfigured/guest mode.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Absolute path to your server-only service-account JSON; forward slashes work on Windows.
GOOGLE_APPLICATION_CREDENTIALS=
